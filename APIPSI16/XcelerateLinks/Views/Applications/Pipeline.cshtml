@{
    ViewData["Title"] = "Application Pipeline";
    var companyId = ViewBag.CompanyId as int? ?? 0;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Application Pipeline</h2>
            <p class="text-muted">Manage applications and move candidates through the hiring process</p>
        </div>
    </div>

    <div class="row" id="pipelineContainer">
        <div class="col-12">
            <div class="d-flex overflow-auto pb-3" style="gap: 20px;">
                <!-- Pipeline columns will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
<script>
    const companyId = @companyId;
    let pipeline = [];

    const stageColors = {
        0: 'primary',
        1: 'info',
        2: 'warning',
        3: 'success',
        4: 'success',
        5: 'danger'
    };

    async function loadPipeline() {
        try {
            const response = await fetch(`/api/jobapplications/company/${companyId}/pipeline`, {
                headers: {
                    'Authorization': 'Bearer ' + (localStorage.getItem('token') || '')
                }
            });

            pipeline = await response.json();
            renderPipeline();
        } catch (error) {
            console.error('Error loading pipeline:', error);
            alert('Failed to load pipeline data');
        }
    }

    function renderPipeline() {
        const container = document.querySelector('#pipelineContainer .d-flex');
        container.innerHTML = '';

        pipeline.forEach(stage => {
            const column = document.createElement('div');
            column.className = 'card';
            column.style.minWidth = '300px';
            column.style.maxWidth = '350px';
            column.setAttribute('data-stage', stage.stage);

            const stageColor = stageColors[stage.stage] || 'secondary';

            column.innerHTML = `
                <div class="card-header bg-${stageColor} text-white">
                    <h5 class="mb-0">
                        ${stage.stageName}
                        <span class="badge bg-light text-dark float-end">${stage.applications.length}</span>
                    </h5>
                </div>
                <div class="card-body p-2" style="min-height: 200px; max-height: calc(100vh - 300px); overflow-y: auto;">
                    <div class="stage-cards" data-stage="${stage.stage}">
                        ${stage.applications.map(app => renderApplicationCard(app)).join('')}
                    </div>
                </div>
            `;

            container.appendChild(column);

            // Initialize drag and drop for this column
            const stageCards = column.querySelector('.stage-cards');
            new Sortable(stageCards, {
                group: 'pipeline',
                animation: 150,
                onEnd: function(evt) {
                    const applicationId = evt.item.getAttribute('data-application-id');
                    const newStage = evt.to.getAttribute('data-stage');
                    updateApplicationStage(applicationId, newStage);
                }
            });
        });
    }

    function renderApplicationCard(app) {
        return `
            <div class="card mb-2 application-card" 
                 data-application-id="${app.jobApplicationId}"
                 style="cursor: move;">
                <div class="card-body p-2">
                    <h6 class="card-title mb-1">
                        <a href="/Users/Details/${app.userId}" target="_blank">
                            ${app.userName || 'Unknown'}
                        </a>
                    </h6>
                    <p class="card-text small text-muted mb-1">
                        <strong>${app.opportunityTitle || 'N/A'}</strong>
                    </p>
                    <small class="text-muted">
                        Applied: ${new Date(app.appliedAt).toLocaleDateString()}
                    </small>
                </div>
            </div>
        `;
    }

    async function updateApplicationStage(applicationId, newStage) {
        try {
            const response = await fetch(`/api/jobapplications/${applicationId}/stage`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + (localStorage.getItem('token') || '')
                },
                body: JSON.stringify({ newStage: parseInt(newStage) })
            });

            if (!response.ok) {
                throw new Error('Failed to update stage');
            }

            console.log('Application stage updated successfully');
            
            // Show success feedback
            showToast('Application moved successfully!', 'success');
        } catch (error) {
            console.error('Error updating stage:', error);
            showToast('Failed to move application. Please try again.', 'danger');
            
            // Reload pipeline to restore correct state
            await loadPipeline();
        }
    }

    function showToast(message, type = 'info') {
        const toast = document.createElement('div');
        toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
        toast.style.top = '20px';
        toast.style.right = '20px';
        toast.style.zIndex = '9999';
        toast.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        document.body.appendChild(toast);
        
        setTimeout(() => {
            toast.remove();
        }, 3000);
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        if (companyId > 0) {
            loadPipeline();
            
            // Auto-refresh every 30 seconds
            setInterval(loadPipeline, 30000);
        } else {
            alert('Invalid company ID');
        }
    });
</script>
}

<style>
    .application-card {
        transition: all 0.3s ease;
    }

    .application-card:hover {
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        transform: translateY(-2px);
    }

    .sortable-ghost {
        opacity: 0.5;
        background: #f8f9fa;
    }

    .stage-cards:empty {
        min-height: 100px;
        border: 2px dashed #dee2e6;
        border-radius: 4px;
    }

    .stage-cards:empty::before {
        content: 'Drop applications here';
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100px;
        color: #6c757d;
    }
</style>
